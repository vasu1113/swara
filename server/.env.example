# Sarvam AI key — used for speech-to-text, text-to-speech, and OCR via the Sarvam API
SARVAM_API_KEY=

# Google API key — used to call Gemini models for reasoning and form-field mapping
GOOGLE_API_KEY=

# Supabase project URL — the base URL of your Supabase project (e.g. https://xxxx.supabase.co)
SUPABASE_URL=

# Supabase service-role secret key — grants full read/write access to the context vault; never expose client-side
SUPABASE_SERVICE_KEY=
